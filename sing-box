{
  "log": {
    "level": "error",
    "output": "box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "h3",
        "tag": "Remote",
        "detour": "Manual",
        "domain_resolver": "Hosts",
        "server": "cloudflare-dns.com"
      },
      {
        "type": "h3",
        "tag": "Local",
        "domain_resolver": "Hosts",
        "server": "dns.alidns.com"
      },
      {
        "type": "hosts",
        "tag": "Hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6",
            "2400:3200::1",
            "2400:3200:baba::1"
          ],
          "cloudflare-dns.com": [
            "1.1.1.1",
            "1.0.0.1",
            "2606:4700:4700::1111",
            "2606:4700:4700::1001"
          ]
        }
      },
      {
        "type": "fakeip",
        "tag": "FakeIP",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "clash_mode": "Global",
        "server": "Remote"
      },
      {
        "clash_mode": "Direct",
        "server": "Local"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "category-ads-all",
          "openai@ads"
        ],
        "action": "reject"
      },
      {
        "rule_set": "bilibili@!cn",
        "server": "FakeIP",
        "rewrite_ttl": 1
      },
      {
        "rule_set": "geolocation-cn",
        "server": "Local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "FakeIP",
        "rewrite_ttl": 1
      }
    ],
    "strategy": "prefer_ipv6",
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "client_subnet": "202.96.0.0/11"
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.ntsc.ac.cn",
    "server_port": 123
  },
  "http_clients": [
    {
      "tag": "Manual",
      "detour": "Manual"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "Direct"
    },
    "<OUTBOUND_REPLACE>",
    {
      "type": "selector",
      "tag": "Manual",
      "outbounds": [
        "Direct",
        "Automatic",
        "<NODE_REPLACE>"
      ],
      "default": "Automatic"
    },
    {
      "type": "urltest",
      "tag": "Automatic",
      "outbounds": [
        "<NODE_REPLACE>"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "5m0s",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "Bilibili@!cn",
      "outbounds": [
        "Manual",
        "<NODE_REPLACE>"
      ]
    },
    {
      "type": "selector",
      "tag": "Microsoft",
      "outbounds": [
        "Manual",
        "Direct",
        "<NODE_REPLACE>"
      ]
    },
    {
      "type": "selector",
      "tag": "Google",
      "outbounds": [
        "Manual",
        "<NODE_REPLACE>"
      ]
    },
    {
      "type": "selector",
      "tag": "Telegram",
      "outbounds": [
        "Manual",
        "<NODE_REPLACE>"
      ]
    },
    {
      "type": "selector",
      "tag": "ChatGPT",
      "outbounds": [
        "Manual",
        "<NODE_REPLACE>"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "clash_mode": "Global",
        "outbound": "Manual"
      },
      {
        "clash_mode": "Direct",
        "outbound": "Direct"
      },
      {
        "ip_is_private": true,
        "outbound": "Direct"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "protocol": "bittorrent",
        "outbound": "Direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          },
          {
            "rule_set": [
              "category-ads-all",
              "openai@ads"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": "bilibili@!cn",
        "outbound": "Bilibili@!cn"
      },
      {
        "rule_set": [
          "microsoft@cn",
          "google@cn",
          "private",
          "cn"
        ],
        "outbound": "Direct"
      },
      {
        "rule_set": "microsoft",
        "outbound": "Microsoft"
      },
      {
        "rule_set": "google",
        "outbound": "Google"
      },
      {
        "rule_set": "telegram",
        "outbound": "Telegram"
      },
      {
        "rule_set": "openai",
        "outbound": "ChatGPT"
      },
      {
        "inbound": "mixed-in",
        "action": "resolve"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "Direct"
      },
      {
        "rule_set": "geoip-telegram",
        "outbound": "Telegram"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "category-ads-all",
          "geolocation-cn",
          "bilibili@!cn",
          "microsoft@cn",
          "openai@ads",
          "google@cn",
          "microsoft",
          "telegram",
          "private",
          "google",
          "openai",
          "cn"
        ],
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/sing-geosite/rule-set/{tag}.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-telegram",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/geoip/release/srs/telegram.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/nekolsd/geoip/release/srs/cn.srs"
      }
    ],
    "final": "Manual",
    "auto_detect_interface": true,
    "default_http_client": "Manual",
    "default_domain_resolver": "Local"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
